# Whisper ASR engine (see https://ahmetoner.com/whisper-asr-webservice/run/)
ASR_ENGINE=faster_whisper
ASR_MODEL=base
ASR_DEVICE=cpu

# Optional: faster-whisper compute type on CPU (int8 reduces RAM and speeds up inference)
# ASR_COMPUTE_TYPE=int8

# Model cache inside the container (mapped to ./cache on the host)
ASR_MODEL_PATH=/data/whisper

# Host port binding (Docker maps 127.0.0.1:WHISPER_PORT -> container 9000)
WHISPER_PORT=9000

# Shared secret — must match Rafael TRANSCRIBER_API_KEY and nginx bearer check
# Generate with: openssl rand -hex 32
API_BEARER_TOKEN=99a2e2ee18b0c25a2fdb8671958627972b0f484d1760cd23f528306b1e814eb8
